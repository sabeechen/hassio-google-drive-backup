# The authorization/token server deployed to Cloud Run and Heroku (habackup.io).
FROM python:3.14-slim
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

ENV APP_HOME=/server
WORKDIR $APP_HOME

# Install locked dependencies first so source changes don't invalidate the layer.
COPY pyproject.toml uv.lock .python-version ./
ENV UV_PYTHON_DOWNLOADS=never
RUN uv sync --locked --no-dev --no-install-project --extra server --compile-bytecode

# The app runs from source in /server; settings.py expects config.json next to the backup package.
COPY . ./
ENV PATH="/server/.venv/bin:${PATH}"

ENTRYPOINT ["python3", "-m", "backup.server"]
